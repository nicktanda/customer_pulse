# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable the accent colour picker in user preferences.
NEXT_PUBLIC_ACCENT_COLOUR_ENABLED=false
