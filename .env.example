# ── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" to enable the user-selectable accent colour picker.
# Ships disabled by default; enable in staging / A-B test cohorts first.
NEXT_PUBLIC_FF_ACCENT_COLOR_PICKER=false
